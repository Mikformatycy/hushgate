# A device that is on the network and trusts the company CA, but was never
# registered as an agent node: proxy settings come from network auto-config,
# without device credentials.
HTTPS_PROXY=http://gate:3128
HTTP_PROXY=http://gate:3128
NO_PROXY=localhost,127.0.0.1
INSTALL_CORP_CA=1
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
