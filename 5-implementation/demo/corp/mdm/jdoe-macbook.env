# MDM profile for an enrolled device, pushed at onboarding. The employee never
# edits this. In production the proxy would come from a PAC file or the web
# gateway's client app, and the identity from a device certificate.
HTTPS_PROXY=http://jdoe-macbook:dev-7f3a9c1e@gate:3128
HTTP_PROXY=http://jdoe-macbook:dev-7f3a9c1e@gate:3128
NO_PROXY=localhost,127.0.0.1
INSTALL_CORP_CA=1
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corp-ca.crt
